# Nginx — HTTPS na frente do Ritmo.
# Copie para /etc/nginx/sites-available/ritmo, troque o domínio e ative:
#   sudo ln -s /etc/nginx/sites-available/ritmo /etc/nginx/sites-enabled/ritmo
#   sudo certbot --nginx -d ritmo.seudominio.com     # cria o certificado e ajusta este arquivo
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name ritmo.seudominio.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ritmo.seudominio.com;

    ssl_certificate     /etc/letsencrypt/live/ritmo.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ritmo.seudominio.com/privkey.pem;

    client_max_body_size 2m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;      # mesma porta de APP_PORT no .env
        proxy_http_version 1.1;
        proxy_set_header Host $host;           # o app confere a origem das requisições
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# Copie este arquivo para ".env" na VPS e preencha. NUNCA envie o .env para o Git.

# Endereço público (com HTTPS) pelo qual você vai abrir o app:
PUBLIC_URL=https://ritmo.seudominio.com

# Senha do PostgreSQL. Gere uma com:  openssl rand -hex 24
# (use só letras e números, porque ela entra na URL de conexão)
POSTGRES_PASSWORD=troque-esta-senha

# Porta local onde o app escuta (somente em 127.0.0.1; o seu proxy aponta para ela).
APP_PORT=3000

# Depois de criar a sua conta, mude para false para fechar o cadastro de novas contas.
ALLOW_SIGNUP=true

# O app roda atrás do seu proxy (Nginx/Caddy/Apache): confia no IP real enviado por ele.
TRUST_PROXY=true
